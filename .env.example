# Local embedded Postgres data directory (default: .data/pg)
PGLITE_DATA_DIR=.data/pg

# Production server config (used by `bun run start`)
HOST=0.0.0.0
PORT=3000

# Set true only when the app is served over HTTPS.
COOKIE_SECURE=false

# Optional AI adapter (off by default in the pilot)
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=
